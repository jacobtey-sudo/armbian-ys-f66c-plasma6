# Pinned inputs for the YS-F66C Plasma 6 image.
# Update deliberately and record the reason in the commit message.
# Every pin must point to an existing public commit.

# Armbian build framework
ARMBIAN_BUILD_REPO="https://github.com/armbian/build.git"
ARMBIAN_BUILD_COMMIT="51d1cc65daa425010bc93d7fcff75ffdecc90670"

# Board support / userpatches (DTS, U-Boot, kernel patches, board packages)
ARMBIAN_BASE_REPO="https://github.com/jacobtey-sudo/armbian-ys-f66c.git"
ARMBIAN_BASE_COMMIT="b55b7e0"

# Armbian board config name: userpatches/config-<name>.conf in the board support repo
BOARD_CONFIG="ys-f66c-trixie"

# Desktop stack (documentation and release notes)
DISTRO="Debian 13 (trixie)"
PLASMA_VERSION="6.3.6"
QT_VERSION="6.8.2"

# Board kernel
KERNEL_VERSION="6.1.172-vendor-rk35xx"
