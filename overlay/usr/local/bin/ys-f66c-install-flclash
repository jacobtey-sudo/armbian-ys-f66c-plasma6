#!/bin/sh
# Install the FlClash proxy client (arm64) from the pinned release.
# The image does not ship the .deb. Download it and verify the SHA256.
# Version and checksum come from /etc/ys-f66c/versions.env.
set -eu

VERSIONS_FILE="${VERSIONS_FILE:-/etc/ys-f66c/versions.env}"
if [ ! -r "${VERSIONS_FILE}" ]; then
	echo "missing ${VERSIONS_FILE}; cannot determine the FlClash version" >&2
	exit 1
fi
# shellcheck source=/dev/null
. "${VERSIONS_FILE}"
: "${FLCLASH_VERSION:?FLCLASH_VERSION is not set in ${VERSIONS_FILE}}"
: "${FLCLASH_SHA256:?FLCLASH_SHA256 is not set in ${VERSIONS_FILE}}"

VERSION="${FLCLASH_VERSION}"
SHA256="${FLCLASH_SHA256}"
URL="https://github.com/chen08209/FlClash/releases/download/v${VERSION}/FlClash-${VERSION}-linux-arm64.deb"

if dpkg-query -W -f='${Version}\n' flclash 2>/dev/null | grep -q "^${VERSION}"; then
	echo "flclash ${VERSION} is installed"
	exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

echo "downloading FlClash ${VERSION} (arm64)"
if ! curl -fSL --retry 3 --connect-timeout 20 -o "${tmp}/flclash.deb" "${URL}"; then
	echo "curl failed; retry with wget" >&2
	wget -q -O "${tmp}/flclash.deb" "${URL}"
fi
echo "${SHA256}  ${tmp}/flclash.deb" | sha256sum -c -

DEBIAN_FRONTEND=noninteractive dpkg -i "${tmp}/flclash.deb"
